@inject IJSRuntime JSRuntime
@using KsarErpLite.Models

<div id="@MapId" style="height: 500px; width: 100%; border-radius: 8px; border: 1px solid #ccc;"></div>

@code {
    [Parameter]
    public string MapId { get; set; } = "map";

    // Создаем событие, на которое сможет подписаться родительская страница
    [Parameter]
    public EventCallback OnMapReady { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Сначала инициализируем саму карту
            await JSRuntime.InvokeVoidAsync("ksarMap.init", MapId);
            
            // 2. Затем сообщаем родительскому компоненту, что мы готовы
            if (OnMapReady.HasDelegate)
            {
                await OnMapReady.InvokeAsync();
            }
        }
    }

    public async Task DrawTrackAsync(KsarTrackData trackData)
    {
        await JSRuntime.InvokeVoidAsync("ksarMap.drawKsarTrack", trackData);
    }
}