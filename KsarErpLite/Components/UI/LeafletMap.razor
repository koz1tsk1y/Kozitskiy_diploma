@inject IJSRuntime JSRuntime
@using KsarErpLite.Models

<div id="@uniqueMapId" style="height: 500px; width: 100%; border-radius: 8px; border: 1px solid #ccc; z-index: 1;"></div>

@code {
    // Генерируем случайный уникальный ID для контейнера
    private string uniqueMapId = "map_" + Guid.NewGuid().ToString("N");

    [Parameter]
    public EventCallback OnMapReady { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("ksarMap.init", uniqueMapId);
            
            if (OnMapReady.HasDelegate)
            {
                await OnMapReady.InvokeAsync();
            }
        }
    }

    public async Task DrawTrackAsync(KsarTrackData trackData)
    {
        await JSRuntime.InvokeVoidAsync("ksarMap.drawKsarTrack", trackData);
    }
}