@page "/jobs/{Id:guid}"
@rendermode InteractiveServer
@using KsarErpLite.Models
@using KsarErpLite.Services
@using KsarErpLite.Components.UI
@using System.IO
@inject IJobService JobService
@inject IKsarParserService KsarParser
@inject NavigationManager Navigation

<PageTitle>Детали заявки</PageTitle>

@if (job == null)
{
    <p><em>Загрузка данных заявки...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-6">
            <h3>Заявка: @job.Customer</h3>
            <p><strong>Статус:</strong> @job.Status</p>
            <p><strong>ID:</strong> @job.Id</p>
            <button class="btn btn-sm btn-outline-danger mt-2" @onclick="DeleteCurrentJob">
                🗑 Удалить заявку
            </button>
            @if (job.Status == JobStatus.Completed)
            {
                <div class="card border-success mt-3 bg-light">
                    <div class="card-body">
                        <h5 class="text-success fw-bold">🧾 Задание выполнено бригадой</h5>
                        <p class="small text-muted mb-3">Проверьте трек на карте. Если объемы и геометрия сходятся с проектом КСАР, закройте задачу для передачи в архив.</p>
                        <button class="btn btn-success w-100 fw-bold" @onclick="CloseJobOfficial">
                            ✅ Проверено, закрыть заявку
                        </button>
                    </div>
                </div>
            }
            @if (job.TrackLength.HasValue)
            {
                <p><strong>Количество точек трека:</strong> @job.TrackLength.Value</p>
            }
        </div>
        <div class="col-md-6 text-end">
            <div class="card p-3 bg-light">
                <h5>Загрузка проекта (КСАР)</h5>
                @if (job.Status == JobStatus.New)
                {
                    <p class="text-muted small">Прикрепите XML-файл виртуального трека</p>
                    <InputFile OnChange="HandleXmlUpload" accept=".xml" class="form-control" />
                    @if (isUploading)
                    {
                        <div class="spinner-border spinner-border-sm text-primary mt-2" role="status"></div>
                    }
                }
                else
                {
                    <div class="alert alert-success p-2 mb-0">Проект успешно загружен</div>
                }
            </div>
        </div>
    </div>

    <LeafletMap @ref="mapComponent" OnMapReady="RestoreTrackAsync" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Job? job;
    private LeafletMap? mapComponent;
    private bool isUploading = false;

    protected override async Task OnInitializedAsync()
    {
        job = await JobService.GetJobByIdAsync(Id);
    }

    private async Task DeleteCurrentJob()
    {
        // Вызываем метод удаления из нашего сервиса
        await JobService.DeleteJobAsync(job!.Id);

        // Возвращаемся в список заявок
        Navigation.NavigateTo("/jobs");
    }

    private async Task CloseJobOfficial()
    {
        if (job == null) return;

        job.Status = JobStatus.Closed;
        await JobService.UpdateJobAsync(job);

        // Возвращаем в общий список документов
        Navigation.NavigateTo("/jobs");
    }

    // Этот метод теперь вызывается ТОЛЬКО когда карта физически готова
    private async Task RestoreTrackAsync()
    {
        if (job != null && !string.IsNullOrEmpty(job.KsarXmlRoute) && File.Exists(job.KsarXmlRoute))
        {
            try
            {
                await using var readStream = File.OpenRead(job.KsarXmlRoute);
                var trackData = await KsarParser.ParseXmlAsync(readStream);
                
                if (mapComponent != null)
                {
                    await mapComponent.DrawTrackAsync(trackData);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка авто-восстановления трека: {ex.Message}");
            }
        }
    }

    private async Task HandleXmlUpload(InputFileChangeEventArgs e)
    {
        if (job == null) return;
        isUploading = true;

        try
        {
            var maxAllowedSize = 10 * 1024 * 1024; // Лимит 10 МБ
            
            // Определяем путь к папке Uploads в корне проекта
            var uploadsFolder = Path.Combine(Directory.GetCurrentDirectory(), "Uploads");
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }

            // Формируем имя файла на основе ID заявки
            var filePath = Path.Combine(uploadsFolder, $"{job.Id}.xml");

            // Физически сохраняем файл из браузера на диск сервера
            await using (var fileStream = new FileStream(filePath, FileMode.Create))
            {
                await e.File.OpenReadStream(maxAllowedSize).CopyToAsync(fileStream);
            }

            // Читаем уже сохраненный файл для парсинга и вывода на карту
            await using (var readStream = File.OpenRead(filePath))
            {
                var trackData = await KsarParser.ParseXmlAsync(readStream);

                if (trackData.TrackPoints.Any() && mapComponent != null)
                {
                    // Отрисовка
                    await mapComponent.DrawTrackAsync(trackData);

                    // Обновление данных в БД
                    job.Status = JobStatus.ProjectLoaded;
                    job.TrackLength = trackData.TrackPoints.Count;
                    job.KsarXmlRoute = filePath; // Записываем путь к файлу в базу данных
                    
                    await JobService.UpdateJobAsync(job);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при обработке и сохранении XML: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }
}