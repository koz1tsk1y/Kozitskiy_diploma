@page "/jobs/{Id:guid}"
@attribute [Authorize(Roles = "Admin, Dispatcher")]
@rendermode InteractiveServer
@using KsarErpLite.Models
@using KsarErpLite.Services
@using KsarErpLite.Components.UI
@using System.IO
@inject IJobService JobService
@inject IKsarParserService KsarParser
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Детали заявки</PageTitle>

@if (job == null)
{
    <p><em>Загрузка данных заявки...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-6">
            <h3>Заявка: @job.Customer</h3>
            
            <p class="mb-1"><strong>Статус:</strong> @GetStatusTemplateName(job.Status)</p>
            
            <p class="mb-1">
                <strong>Запланированная дата:</strong> 
                @if (job.PlanDate.HasValue)
                {
                    <span>@job.PlanDate.Value.ToString("dd.MM.yyyy")</span>
                }
                else
                {
                    <span>Не назначена (В очереди)</span>
                }
            </p>
            
            <p class="text-muted small mb-3"><strong>ID:</strong> @job.Id</p>

            <div class="mb-3 p-3 bg-light rounded border mt-3">
                <label class="form-label small fw-bold text-secondary">Назначить исполнителя (Бригадира):</label>
                <div class="input-group input-group-sm">
                    <select class="form-select" @bind="selectedForemanId">
                        <option value="@Guid.Empty">-- Не назначен --</option>
                        @foreach (var foreman in foremen)
                        {
                            <option value="@foreman.Id">@foreman.FullName</option>
                        }
                    </select>
                    <button type="button" class="btn btn-primary" @onclick="AssignForeman">💾</button>
                </div>
                
                @if (showSaveSuccess)
                {
                    <div class="text-success small fw-bold mt-2 animate__animated animate__fadeIn">
                        ✅ Исполнитель успешно назначен!
                    </div>
                }
            </div>

            @if (job.Status == JobStatus.Completed || job.Status == JobStatus.Closed)
            {
                <div class="card shadow-sm border-0 mb-4 border-top border-success border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold text-success mb-1">Работы по объекту завершены</h6>
                            <p class="text-muted small mb-0">Вы можете сформировать официальный документ для заказчика.</p>
                        </div>
                        <button type="button" class="btn btn-success fw-bold py-2 px-4" @onclick="ShowActModal">
                            📄 Сформировать Акт (PDF)
                        </button>
                    </div>
                </div>
            }

            @if (isActModalOpen)
            {
                <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); overflow-y: auto;" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content border-0 rounded-4 shadow-lg">
                            <div class="modal-header bg-light border-0 py-3 d-print-none">
                                <h5 class="modal-title fw-bold">Предварительный просмотр документа</h5>
                                <button type="button" class="btn-close" @onclick="CloseActModal"></button>
                            </div>
        
                            <div class="modal-body p-5 bg-white text-dark workflow-act-print" id="printable-act">
                                <div class="text-center mb-4">
                                    <h4 class="fw-bold mb-1 text-uppercase" style="letter-spacing: 1px;">Акт выполненных работ</h4>
                                    <p class="text-muted small">по договору на нанесение дорожной разметки</p>
                                </div>

                                <div class="d-flex justify-content-between mb-4 small border-bottom pb-2">
                                    <span><strong>Дата составления:</strong> @DateTime.Now.ToString("dd.MM.yyyy")</span>
                                    <span><strong>Номер заявки:</strong> № @job.Id.ToString().Substring(0, 8).ToUpper()</span>
                                </div>

                                <div class="mb-4">
                                    <p class="mb-1"><strong>Исполнитель:</strong> СООО «СТиМ» (Конструкторское бюро №2)</p>
                                    <p class="mb-0"><strong>Заказчик (Объект):</strong> @job.Customer</p>
                                </div>

                                <p class="mb-3">
                                    Мы, нижеподписавшиеся, составили настоящий акт в том, что Исполнитель выполнил, а Заказчик принял работы по автоматизированному нанесению (восстановлению) дорожной разметки с применением комплекса КСАР.
                                </p>

                                <table class="table table-bordered border-dark align-middle my-4 text-center small">
                                    <thead class="table-light border-dark">
                                        <tr>
                                            <th>Наименование работ</th>
                                            <th>Кол-во точек лога КСАР</th>
                                            <th>Расчетный объем</th>
                                            <th>Ед. изм.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-start">@(job.WorkType?.Name ?? "Дорожная разметка")</td>
                                            <td>@(job.TrackLength?.ToString() ?? "—")</td>
                                            <td>@CalculateVolume().ToString("F2")</td>
                                            <td>@(job.WorkType?.Unit ?? "—")</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <p class="mb-4">
                                    <strong>Заключение:</strong> Работы выполнены в полном объеме, согласно разработанному виртуальному проекту разметки. Стороны претензий друг к другу не имеют.
                                </p>

                                <div class="row mt-5 pt-4">
                                    <div class="col-6 border-end border-secondary">
                                        <p class="mb-4 small text-muted text-uppercase">От Исполнителя (Бригадир):</p>
                                        <div class="d-flex align-items-end mt-4">
                                            <span class="text-decoration-underline me-2">@(job.Foreman?.FullName ?? "__________________")</span>
                                            <span class="small text-muted">(подпись)</span>
                                        </div>
                                    </div>
                                    <div class="col-6 ps-4">
                                        <p class="mb-4 small text-muted text-uppercase">От Заказчика:</p>
                                        <div class="d-flex align-items-end mt-4">
                                            <span>_______________________</span>
                                            <span class="small text-muted ms-2">(подпись)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                 
                            <div class="modal-footer bg-light border-0 d-print-none py-3">
                                <button type="button" class="btn btn-secondary rounded-3 fw-bold" @onclick="CloseActModal">Закрыть</button>
                                <button type="button" class="btn btn-primary rounded-3 fw-bold px-4" @onclick="PrintAct">
                                    🖨 Распечатать / Сохранить в PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <button class="btn btn-sm btn-outline-danger mt-2" @onclick="DeleteCurrentJob">
                🗑 Удалить заявку
            </button>
            @if (job.Status == JobStatus.Completed)
            {
                <div class="card border-success mt-3 bg-light">
                    <div class="card-body">
                        <h5 class="text-success fw-bold">🧾 Задание выполнено бригадой</h5>
                        <p class="small text-muted mb-3">Проверьте трек на карте. Если объемы и геометрия сходятся с проектом КСАР, закройте задачу для передачи в архив.</p>
                        <button class="btn btn-success w-100 fw-bold" @onclick="CloseJobOfficial">
                            ✅ Проверено, закрыть заявку
                        </button>
                    </div>
                </div>
            }
        </div>
        
        <div class="col-md-6 text-end">
            <div class="card p-3 bg-light text-start">
                <h5>Загрузка проекта (КСАР)</h5>
                
                @if (string.IsNullOrEmpty(job.KsarXmlRoute))
                {
                    <p class="text-muted small">Прикрепите XML-файл виртуального трека</p>
                    <InputFile OnChange="HandleXmlUpload" accept=".xml" class="form-control" />
                    @if (isUploading)
                    {
                        <div class="spinner-border spinner-border-sm text-primary mt-2" role="status"></div>
                    }
                }
                else
                {
                    <div class="alert alert-success d-flex justify-content-between align-items-center mt-3 shadow-sm">
                        <div>
                            <span class="fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Проект успешно прикреплен</span>
                            <div class="small mt-1 text-muted">Длина маршрута: @job.TrackLength точек</div>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm fw-bold" @onclick="DeleteXmlFileAsync">
                            🗑 Удалить
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <LeafletMap @ref="mapComponent" OnMapReady="RestoreTrackAsync" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private List<User> foremen = new();
    private Guid selectedForemanId;
    private Job? job;
    private LeafletMap? mapComponent;
    private bool isUploading = false;
    private bool isActModalOpen = false;
    private bool showSaveSuccess = false;

    private void ShowActModal() => isActModalOpen = true;
    private void CloseActModal() => isActModalOpen = false;

    private async Task PrintAct()
    {
        // Вызываем системную печать браузера
        await JSRuntime.InvokeVoidAsync("printPage");
    }

    // Математика перевода точек в физический объем (точно такая же как в отчете по материалам)
    private double CalculateVolume()
    {
        if (job == null || !job.TrackLength.HasValue) return 0;
        
        if (job.WorkType?.Unit?.ToLower() == "км")
        {
            return (job.TrackLength.Value * 2.0) / 1000.0; // 1 точка = 2 метра трассы
        }
        if (job.WorkType?.Unit?.ToLower() == "м2")
        {
            return job.TrackLength.Value * 0.5; // 1 точка = 0.5 м2
        }
        return job.TrackLength.Value;
    }
    
    protected override async Task OnInitializedAsync()
    {
        job = await JobService.GetJobByIdAsync(Id);
        // Загружаем список всех бригадиров для назначения
        foremen = await JobService.GetUsersByRoleAsync(UserRole.Foreman);
        
        if (job != null && job.ForemanId.HasValue)
        {
            selectedForemanId = job.ForemanId.Value;
        }
    }

    private async Task AssignForeman()
    {
        if (job == null) return;
        
        if (selectedForemanId == Guid.Empty)
        {
            job.ForemanId = null;
        }
        else
        {
            job.ForemanId = selectedForemanId;
        }

        await JobService.UpdateJobAsync(job);
        job = await JobService.GetJobByIdAsync(Id);
        
        // Включаем зеленую надпись, обновляем экран, ждем 2 секунды и убираем
        showSaveSuccess = true;
        StateHasChanged(); // Принудительно заставляем Blazor отрисовать изменения
        
        await Task.Delay(2000); // Ждем 2 секунды
        
        showSaveSuccess = false;
        StateHasChanged();
    }

    private async Task DeleteCurrentJob()
    {
        // Вызываем метод удаления из нашего сервиса
        await JobService.DeleteJobAsync(job!.Id);
        // Возвращаемся в список заявок
        Navigation.NavigateTo("/jobs");
    }

    private async Task CloseJobOfficial()
    {
        if (job == null) return;
        
        job.Status = JobStatus.Closed;
        await JobService.UpdateJobAsync(job);

        // Возвращаем в общий список документов
        Navigation.NavigateTo("/jobs");
    }

    // Этот метод теперь вызывается ТОЛЬКО когда карта физически готова
    private async Task RestoreTrackAsync()
    {
        if (job != null && !string.IsNullOrEmpty(job.KsarXmlRoute) && File.Exists(job.KsarXmlRoute))
        {
            try
            {
                await using var readStream = File.OpenRead(job.KsarXmlRoute);
                var trackData = await KsarParser.ParseXmlAsync(readStream);
                
                if (mapComponent != null)
                {
                    await mapComponent.DrawTrackAsync(trackData);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка авто-восстановления трека: {ex.Message}");
            }
        }
    }

    private async Task HandleXmlUpload(InputFileChangeEventArgs e)
    {
        if (job == null) return;
        
        isUploading = true;
        StateHasChanged(); // Показываем спиннер загрузки

        try
        {
            var maxAllowedSize = 10 * 1024 * 1024; // Лимит 10 МБ
            var uploadsFolder = Path.Combine(Directory.GetCurrentDirectory(), "Uploads");
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }

            var filePath = Path.Combine(uploadsFolder, $"{job.Id}.xml");
            
            // 1. Сохраняем файл физически
            await using (var fileStream = new FileStream(filePath, FileMode.Create))
            {
                await e.File.OpenReadStream(maxAllowedSize).CopyToAsync(fileStream);
            }

            // 2. Читаем и парсим файл ОДИН раз (сохраняем данные в переменную parsedData)
            KsarTrackData? parsedData = null;
            await using (var readStream = File.OpenRead(filePath))
            {
                parsedData = await KsarParser.ParseXmlAsync(readStream);
            }
            
            if (parsedData != null && parsedData.TrackPoints.Any())
            {
                // 3. Обновляем данные в БД
                job.TrackLength = parsedData.TrackPoints.Count;
                job.Status = JobStatus.ProjectLoaded;
                job.KsarXmlRoute = filePath; 
                
                await JobService.UpdateJobAsync(job);

                // 4. Отключаем крутилку загрузки и говорим Blazor обновить HTML интерфейса
                isUploading = false;
                StateHasChanged();
                
                // 5. МАГИЯ: Даем браузеру 100 миллисекунд, чтобы он успел применить HTML-изменения 
                // и освободил поток для тяжелого рендеринга Leaflet.
                await Task.Delay(100);

                // 6. Отрисовываем трек напрямую из памяти, не читая файл заново!
                if (mapComponent != null)
                {
                    await mapComponent.DrawTrackAsync(parsedData);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке XML: {ex.Message}");
            isUploading = false;
            StateHasChanged(); // Скрываем крутилку в случае ошибки
        }
    }

    private async Task DeleteXmlFileAsync()
    {
        if (job == null) return;

        if (!string.IsNullOrEmpty(job.KsarXmlRoute))
        {
            try 
            {
                if (System.IO.File.Exists(job.KsarXmlRoute))
                {
                    System.IO.File.Delete(job.KsarXmlRoute);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при удалении файла: {ex.Message}");
            }
        }

        job.KsarXmlRoute = null;
        job.TrackLength = null;
        
        if (job.Status == JobStatus.ProjectLoaded)
        {
            job.Status = JobStatus.New;
        }

        if (mapComponent != null)
        {
            await mapComponent.ClearMapAsync();
        }

        await JobService.UpdateJobAsync(job);
    }

    

    private string GetStatusTemplateName(JobStatus status) => status switch
    {
        JobStatus.New => "Новая",
        JobStatus.ProjectLoaded => "Проект загружен",
        JobStatus.Scheduled => "В расписании",
        JobStatus.InProgress => "На трассе (В работе)",
        JobStatus.Completed => "Выполнена бригадой",
        JobStatus.Closed => "В архиве (Закрыта)",
        _ => status.ToString()
    };
}