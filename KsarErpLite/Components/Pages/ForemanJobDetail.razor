@page "/foreman/job/{Id:guid}"
@attribute [Authorize(Roles = "Admin, Foreman")]
@rendermode InteractiveServer
@using KsarErpLite.Models
@using KsarErpLite.Services
@using KsarErpLite.Components.UI
@using System.IO
@inject IJobService JobService
@inject IKsarParserService KsarParser
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Выполнение задания</PageTitle>

<div class="container-fluid pb-5" style="max-width: 600px; margin: 0 auto;">
    <div class="mt-3 mb-3">
        <a href="/foreman" class="text-decoration-none text-secondary fw-bold">
            ← Назад к списку задач
        </a>
    </div>

    @if (job == null)
    {
        <div class="text-center mt-5"><div class="spinner-border text-warning"></div></div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 mb-4 bg-dark text-white">
            <div class="card-body p-4">
                <span class="badge bg-warning text-dark mb-2 rounded-pill px-3 fw-bold">В РАБОТЕ</span>
                <h3 class="fw-bold mb-1">@job.Customer</h3>
                <p class="text-light-50 mb-0">
                    <strong>Тип:</strong> @(job.WorkType?.Name ?? "Не указан")
                </p>
                @if (job.TrackLength.HasValue)
                {
                    <p class="text-light-50 mb-0 small mt-1">
                        Длина маршрута: @job.TrackLength.Value точек
                    </p>
                }

                @if (!string.IsNullOrEmpty(job.KsarXmlRoute) && File.Exists(job.KsarXmlRoute))
                {
                    <div class="mt-3 border-top border-secondary pt-3">
                        <button type="button" class="btn btn-warning text-dark w-100 fw-bold py-2 shadow-sm" @onclick="DownloadXmlProjectAsync">
                            💾 СКАЧАТЬ ПРОЕКТ ДЛЯ КСАР (.XML)
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white fw-bold py-3">
                🗺 Карта виртуального трека (КСАР)
            </div>
            <div class="card-body p-0">
                <LeafletMap @ref="mapComponent" OnMapReady="RestoreTrackAsync" />
            </div>
        </div>

        <div class="fixed-bottom-button-container p-3 bg-white border-top">
            <button class="btn btn-success w-100 py-3 fw-bold rounded-4 fs-4 shadow" @onclick="CompleteJob">
                🏁 ЗАВЕРШИТЬ РАБОТУ
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Job? job;
    private LeafletMap? mapComponent;

    protected override async Task OnInitializedAsync()
    {
        job = await JobService.GetJobByIdAsync(Id);
        
        // Защита: если бригадир зашел на страницу задачи, которая не в работе,
        // но имеет статус Scheduled, переводим ее в работу автоматически
        if (job != null && job.Status == JobStatus.Scheduled)
        {
            job.Status = JobStatus.InProgress;
            await JobService.UpdateJobAsync(job);
        }
    }

    // Автоматическая отрисовка трека сразу после готовности карты Leaflet
    private async Task RestoreTrackAsync()
    {
        if (job != null && !string.IsNullOrEmpty(job.KsarXmlRoute) && File.Exists(job.KsarXmlRoute))
        {
            try
            {
                await using var readStream = File.OpenRead(job.KsarXmlRoute);
                var trackData = await KsarParser.ParseXmlAsync(readStream);
                
                if (mapComponent != null)
                {
                    await mapComponent.DrawTrackAsync(trackData);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка вывода трека на мобильном АРМ: {ex.Message}");
            }
        }
    }

    private async Task DownloadXmlProjectAsync()
    {
        if (job != null && !string.IsNullOrEmpty(job.KsarXmlRoute) && File.Exists(job.KsarXmlRoute))
        {
            try
            {
                // Очищаем имя от пробелов и запрещенных символов
                var cleanCustomerName = job.Customer.Replace(" ", "_");
                foreach (var c in Path.GetInvalidFileNameChars())
                {
                    cleanCustomerName = cleanCustomerName.Replace(c.ToString(), "");
                }
                
                var fileName = $"ksar_project_{cleanCustomerName}.xml";

                // Читаем файл и конвертируем его в Base64 (идеально для небольших XML)
                var fileBytes = await File.ReadAllBytesAsync(job.KsarXmlRoute);
                var base64 = Convert.ToBase64String(fileBytes);

                // Вызываем нашу новую надежную JS-функцию
                await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при скачивании XML: {ex.Message}");
            }
        }
    }

    private async Task CompleteJob()
    {
        if (job == null) return;

        // Переводим заявку в статус "Выполнена"
        job.Status = JobStatus.Completed;
        await JobService.UpdateJobAsync(job);

        // Возвращаем бригадира на главный экран со списком задач
        Navigation.NavigateTo("/foreman");
    }
}