@page "/"
@attribute [Authorize(Roles = "Admin, Dispatcher")]
@rendermode InteractiveServer
@using KsarErpLite.Models
@using KsarErpLite.Services
@inject IJobService JobService

<PageTitle>Главная - КСАР ERP</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Сводная аналитика (Дашборд)</h2>
        <span class="text-muted">Данные актуальны на @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
    </div>

    @if (stats == null)
    {
        <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-primary text-white h-100 rounded-4">
                    <div class="card-body">
                        <h6 class="text-uppercase fw-bold text-white-50 mb-1">Всего в базе</h6>
                        <h1 class="display-5 fw-bold mb-0">@totalJobs</h1>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-warning text-dark h-100 rounded-4">
                    <div class="card-body">
                        <h6 class="text-uppercase fw-bold text-dark-50 mb-1">На трассе (В работе)</h6>
                        <h1 class="display-5 fw-bold mb-0">@inProgressJobs</h1>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-info text-dark h-100 rounded-4">
                    <div class="card-body">
                        <h6 class="text-uppercase fw-bold text-dark-50 mb-1">В расписании</h6>
                        <h1 class="display-5 fw-bold mb-0">@scheduledJobs</h1>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-success text-white h-100 rounded-4">
                    <div class="card-body">
                        <h6 class="text-uppercase fw-bold text-white-50 mb-1">Успешно закрыты</h6>
                        <h1 class="display-5 fw-bold mb-0">@completedJobs</h1>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Прогресс выполнения работ</h5>
                        <div class="progress" style="height: 30px; border-radius: 15px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @completionPercent%" title="Закрыто: @completionPercent%">
                                @if (completionPercent > 5) { <span>@completionPercent%</span> }
                            </div>
                            <div class="progress-bar bg-warning text-dark" role="progressbar" style="width: @inProgressPercent%" title="В работе: @inProgressPercent%">
                                @if (inProgressPercent > 5) { <span>@inProgressPercent%</span> }
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-2 small text-muted">
                            <span>0%</span>
                            <span>Доля закрытых заявок от общего объема</span>
                            <span>100%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row mt-4">
            <div class="col-md-4">
                <a href="/jobs" class="btn btn-outline-secondary w-100 py-3 rounded-4 fw-bold">
                    📋 Перейти к списку заявок
                </a>
            </div>
            <div class="col-md-4">
                <a href="/schedule" class="btn btn-outline-secondary w-100 py-3 rounded-4 fw-bold">
                    📅 Открыть расписание
                </a>
            </div>
            <div class="col-md-4">
                <a href="/foreman" class="btn btn-outline-secondary w-100 py-3 rounded-4 fw-bold">
                    📱 АРМ Бригадира
                </a>
            </div>
        </div>
    }
</div>

@code {
    private Dictionary<JobStatus, int>? stats;

    private int totalJobs => stats?.Values.Sum() ?? 0;
    
    // Безопасно достаем значения из словаря (если статуса нет, то 0)
    private int inProgressJobs => stats?.GetValueOrDefault(JobStatus.InProgress) ?? 0;
    private int scheduledJobs => stats?.GetValueOrDefault(JobStatus.Scheduled) ?? 0;
    private int completedJobs => (stats?.GetValueOrDefault(JobStatus.Completed) ?? 0) + (stats?.GetValueOrDefault(JobStatus.Closed) ?? 0);

    // Математика для прогресс-бара
    private int completionPercent => totalJobs == 0 ? 0 : (int)Math.Round((double)completedJobs / totalJobs * 100);
    private int inProgressPercent => totalJobs == 0 ? 0 : (int)Math.Round((double)inProgressJobs / totalJobs * 100);

    protected override async Task OnInitializedAsync()
    {
        stats = await JobService.GetJobsStatisticsAsync();
    }
}