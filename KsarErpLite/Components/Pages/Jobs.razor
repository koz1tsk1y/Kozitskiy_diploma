@page "/jobs"
@using KsarErpLite.Models
@using KsarErpLite.Services
@using KsarErpLite.Data
@inject IJobService JobService
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Заявки на разметку</PageTitle>

<h3>Управление заявками</h3>

<button class="btn btn-primary mb-3" @onclick="CreateTestJob">
    + Создать тестовую заявку
</button>

@if (jobs == null)
{
    <p><em>Загрузка...</em></p>
}
else if (!jobs.Any())
{
    <p>Нет активных заявок. Создайте новую.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID Заявки</th>
                <th>Заказчик</th>
                <th>Статус</th>
                <th>Дата создания</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in jobs)
            {
                <tr>
                    <td>@job.Id.ToString().Substring(0, 8)...</td>
                    <td>@job.Customer</td>
                    <td>
                        <span class="badge @GetStatusBadgeClass(job.Status)">
                            @job.Status.ToString()
                        </span>
                    </td>
                    <td>@(job.PlanDate?.ToString("dd.MM.yyyy") ?? "Не назначена")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToDetails(job.Id)">
                            Открыть
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Job>? jobs;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
    }

    private async Task LoadJobs()
    {
        jobs = await JobService.GetAllJobsAsync();
    }

    private async Task CreateTestJob()
    {
        // 1. Проверяем, есть ли в БД хотя бы один тип работ. Если нет - создаем.
        var workType = DbContext.WorkTypes.FirstOrDefault();
        if (workType == null)
        {
            workType = new WorkType { Name = "Продольная разметка (Тест)", Unit = "км" };
            DbContext.WorkTypes.Add(workType);
            await DbContext.SaveChangesAsync();
        }

        // 2. Проверяем, есть ли тестовый пользователь (Диспетчер).
        var user = DbContext.Users.FirstOrDefault();
        if (user == null)
        {
            user = new User 
            { 
                Login = "dispatcher_test", 
                PasswordHash = "123", // Пока без шифрования
                FullName = "Иванов И.И. (Диспетчер)", 
                Role = UserRole.Dispatcher 
            };
            DbContext.Users.Add(user);
            await DbContext.SaveChangesAsync();
        }

        // 3. Теперь создаем заявку, привязывая реальные ID из базы
        var newJob = new Job
        {
            Customer = "ДЭУ Тест",
            Status = JobStatus.New,
            PlanDate = DateTime.UtcNow.AddDays(1),
            WorkTypeId = workType.Id,
            CreatedById = user.Id
        };

        await JobService.CreateJobAsync(newJob);
        await LoadJobs();
    }

    private void GoToDetails(Guid id)
    {
        Navigation.NavigateTo($"/jobs/{id}");
    }

    private string GetStatusBadgeClass(JobStatus status) => status switch
    {
        JobStatus.New => "bg-secondary",
        JobStatus.ProjectLoaded => "bg-info text-dark",
        JobStatus.Scheduled => "bg-primary",
        JobStatus.InProgress => "bg-warning text-dark",
        JobStatus.Completed => "bg-success",
        JobStatus.Closed => "bg-dark",
        _ => "bg-secondary"
    };
}