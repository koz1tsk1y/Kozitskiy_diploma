@page "/jobs"
@attribute [Authorize(Roles = "Dispatcher")]
@rendermode InteractiveServer
@using KsarErpLite.Models
@using KsarErpLite.Services
@using KsarErpLite.Data
@inject IJobService JobService

<PageTitle>Заявки на разметку</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Управление заявками</h3>
    <a href="/jobs/create" class="btn btn-primary">
        + Создать новую заявку
    </a>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(currentTab == "active" ? "active fw-bold" : "")" @onclick='() => ChangeTab("active")'>
            Активные заяки
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(currentTab == "completed" ? "active fw-bold text-success" : "")" @onclick='() => ChangeTab("completed")'>
            Выполненные бригадой
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(currentTab == "closed" ? "active fw-bold text-muted" : "")" @onclick='() => ChangeTab("closed")'>
            Архив (Закрытые)
        </button>
    </li>
</ul>

@if (filteredJobs == null)
{
    <p><em>Загрузка заявок...</em></p>
}
else if (!filteredJobs.Any())
{
    <div class="alert alert-light text-center py-4">Нет заявок в этой категории.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Заказчик / Объект</th>
                <th>Тип разметки</th>
                <th>Статус</th>
                <th>Плановая дата</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in filteredJobs)
            {
                <tr>
                    <td class="fw-bold">@job.Customer</td>
                    <td>@job.WorkType?.Name</td>
                    <td>
                        <span class="badge @GetStatusBadgeClass(job.Status) px-2 py-1 fs-6">
                            @GetStatusTemplateName(job.Status)
                        </span>
                    </td>
                    <td>@(job.PlanDate?.ToString("dd.MM.yyyy") ?? "Не назначена")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="/jobs/@job.Id">
                            Открыть карточку
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Job>? allJobs;
    private List<Job>? filteredJobs;
    private string currentTab = "active";

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
    }

    private async Task LoadJobs()
    {
        allJobs = await JobService.GetAllJobsAsync();
        ApplyFilter();
    }

    private void ChangeTab(string tab)
    {
        currentTab = tab;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allJobs == null) return;

        filteredJobs = currentTab switch
        {
            "active" => allJobs.Where(j => j.Status == JobStatus.New 
                                        || j.Status == JobStatus.ProjectLoaded 
                                        || j.Status == JobStatus.Scheduled 
                                        || j.Status == JobStatus.InProgress).ToList(),
            
            "completed" => allJobs.Where(j => j.Status == JobStatus.Completed).ToList(),
            
            "closed" => allJobs.Where(j => j.Status == JobStatus.Closed).ToList(),
            
            _ => allJobs
        };
    }

    private string GetStatusBadgeClass(JobStatus status) => status switch
    {
        JobStatus.New => "bg-secondary",
        JobStatus.ProjectLoaded => "bg-info text-dark",
        JobStatus.Scheduled => "bg-primary",
        JobStatus.InProgress => "bg-warning text-dark",
        JobStatus.Completed => "bg-success",
        JobStatus.Closed => "bg-dark text-light",
        _ => "bg-secondary"
    };

    private string GetStatusTemplateName(JobStatus status) => status switch
    {
        JobStatus.New => "Новая",
        JobStatus.ProjectLoaded => "Проект загружен",
        JobStatus.Scheduled => "В расписании",
        JobStatus.InProgress => "На трассе (В работе)",
        JobStatus.Completed => "Выполнена бригадой",
        JobStatus.Closed => "В архиве (Закрыта)",
        _ => status.ToString()
    };
}