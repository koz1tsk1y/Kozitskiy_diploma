@page "/Error"
@using System.Diagnostics
@attribute [AllowAnonymous]

<PageTitle>Системная ошибка</PageTitle>

<div class="container text-center" style="margin-top: 100px; max-width: 500px;">
    <div class="card shadow border-0 rounded-4 p-5 bg-white border-top border-warning border-5">
        <div class="card-body">
            <h1 class="display-1 text-warning mb-4"><i class="bi bi-exclamation-triangle-fill"></i></h1>
            <h3 class="fw-bold mb-3 text-dark">Упс, что-то пошло не так</h3>
            <p class="text-muted mb-4">
                Произошла непредвиденная ошибка сервера. Мы уже зафиксировали проблему. Пожалуйста, вернитесь на главную страницу или обратитесь к системному администратору.
            </p>
            @if (ShowRequestId)
            {
                <div class="alert alert-light text-muted small mt-3">
                    <strong>ID запроса:</strong> <code>@RequestId</code>
                </div>
            }
            <a href="/" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-4 mt-2">
                Вернуться на Дашборд
            </a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}