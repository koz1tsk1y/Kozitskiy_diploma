@page "/access-denied"
@attribute [AllowAnonymous]

<PageTitle>Доступ ограничен</PageTitle>

<div class="container text-center" style="margin-top: 100px; max-width: 500px;">
    <div class="card shadow border-0 rounded-4 p-5 bg-white">
        <div class="card-body">
            <h1 class="display-1 text-danger mb-4">🚫</h1>
            <h3 class="fw-bold mb-3 text-dark">Доступ ограничен</h3>
            <p class="text-muted mb-4">
                У вашей учетной записи недостаточно прав для просмотра этой зоны управления.
            </p>
            <a href="/logout" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-4">
                Войти под другим аккаунтом
            </a>
        </div>
    </div>
</div>